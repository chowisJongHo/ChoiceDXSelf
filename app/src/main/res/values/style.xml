<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="loginEditTextContainer">
        <item name="android:layout_width">@dimen/_230sdp</item>
        <item name="android:layout_height">@dimen/_33sdp</item>
        <item name="android:background">@drawable/bg_edit_text_container</item>
    </style>

    <style name="loginEditText">
        <item name="android:background">@null</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColorHint">@color/editTextHintColor</item>
        <item name="android:textSize">@dimen/_8ssp</item>
    </style>

    <style name="settingsMainTextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/_11ssp</item>
        <item name="android:layout_marginStart">@dimen/_9sdp</item>
    </style>

    <style name="settingsGeneralBase">
        <item name="android:background">@drawable/bg_settings_general_background</item>
    </style>

    <style name="settingsGeneralBase.Container" parent="settingsGeneralBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/_30sdp</item>
    </style>

    <style name="settingsGeneralBase.ItemContainer" parent="settingsGeneralBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">@dimen/_9sdp</item>
        <item name="android:paddingBottom">@dimen/_9sdp</item>
        <item name="android:paddingStart">@dimen/_13sdp</item>
        <item name="android:paddingEnd">@dimen/_13sdp</item>
        <item name="android:layout_marginTop">@dimen/_2sdp</item>
    </style>

    <style name="settingsGeneralItemText">
        <item name="android:textColor">@color/subTextColor</item>
        <item name="android:textSize">@dimen/_10ssp</item>
    </style>
</resources>